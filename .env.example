# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=warrantdb

# Service
API_PORT=8080

# Optional enrichment service keys (add as needed)
# TLOXP_API_KEY=
# TRACERS_API_KEY=

# --- Harris Email Roster support (optional) ---
# Where to save fetched roster files (supports ~ and $HOME)
HARRIS_EMAIL_ROSTER_DIR=~/Dropbox/ASAP_bail/harris_county

# IMAP email fetch (e.g., Gmail/Workspace). For Gmail use an App Password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=1
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_UNSEEN_ONLY=1
IMAP_SINCE_DAYS=14

# Optional filters
# ROSTER_EMAIL_FROM=
# ROSTER_ORIGINAL_FROM=
# ROSTER_SUBJECT_INCLUDE=BondNotif,BondNotif_Changes
# ROSTER_SUBJECT_EXCLUDE=
# ROSTER_SAVE_BY_DATE=1
# ROSTER_MAX_MESSAGES=100
# ROSTER_ALLOWED_EXT=.csv,.xlsx,.xls
# MARK_SEEN=1

# Harris roster importer flags (optional)
# HARRIS_ROSTER_FORCE_REPROCESS=0   # set to 1 to reprocess files even if ledgered
# HARRIS_ROSTER_DEBUG=0            # set to 1 for sheet-level debug logs
