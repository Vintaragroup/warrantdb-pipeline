# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB=warrantdb

# Service
API_PORT=8080

# Optional enrichment service keys (add as needed)
# TLOXP_API_KEY=
# TRACERS_API_KEY=

# --- Harris County DOB enrichment (HCSO) ---
# These URLs change occasionally; set them explicitly when running DOB enrichment.
# Example patterns (placeholders; replace with current public URLs):
# HCSO_SPN_URL_FMT="https://apps.harriscountytx.gov/JailInfo/Detail?spn={spn}"
# HCSO_NAME_URL_FMT="https://apps.harriscountytx.gov/JailInfo/Search?last={last}&first={first}"
# Optional tuning
# HCSO_USER_AGENT="Mozilla/5.0 (compatible; WarrantDB/0.2)"
# HCSO_THROTTLE_SEC=0.7
# HCSO_TIMEOUT_SEC=20
# Optional small pause between different people during enrichment
# HCSO_BETWEEN_PEOPLE_SEC=0.5

# --- Harris Email Roster support (optional) ---
# Where to save fetched roster files (supports ~ and $HOME)
HARRIS_EMAIL_ROSTER_DIR=~/Dropbox/ASAP_bail/harris_county

# IMAP email fetch (e.g., Gmail/Workspace). For Gmail use an App Password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=1
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_UNSEEN_ONLY=1
IMAP_SINCE_DAYS=14

# Optional filters
# ROSTER_EMAIL_FROM=
# ROSTER_ORIGINAL_FROM=
# ROSTER_SUBJECT_INCLUDE=BondNotif,BondNotif_Changes
# ROSTER_SUBJECT_EXCLUDE=
# ROSTER_SAVE_BY_DATE=1
# ROSTER_MAX_MESSAGES=100
# ROSTER_ALLOWED_EXT=.csv,.xlsx,.xls
# MARK_SEEN=1

# Harris roster importer flags (optional)
# HARRIS_ROSTER_FORCE_REPROCESS=0   # set to 1 to reprocess files even if ledgered
# HARRIS_ROSTER_DEBUG=0            # set to 1 for sheet-level debug logs

# Optional: mirror fetched attachments to Dropbox for archival
# Create an access token in Dropbox App Console and paste it here.
# If set, each saved file is uploaded under DROPBOX_BASE_FOLDER
# (default: /warrantdb/email_rosters with optional /YYYY-MM-DD subfolders)
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_BASE_FOLDER=/warrantdb/email_rosters
